<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Laughing Dragons Productions — free browser games, Fruit Friends Kids Show, learning tools, shop, 3D prints, and maker gear from the workroom." />
    <title>Laughing Dragons Productions</title>
    <link rel="icon" href="/assets/brand/ldp-logo.png" type="image/png" />
    <link rel="stylesheet" href="/assets/css/site.css" />
    <link rel="canonical" href="https://laughing-dragons.com/" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7048606415692002"
     crossorigin="anonymous"></script>
  </head>
  <body>
    <div id="app"></div>
    <script src="/assets/js/config.js"></script>
    <script src="/assets/js/site.js"></script>
    <script>
      initPage({
        title: "Laughing Dragons Productions",
        description: "Free browser games, Fruit Friends Kids Show, learning tools, shop, and maker gear from Laughing Dragons Productions.",
        activePath: "/",
        hero: true,
        adSlots: false,
        content: `
          <div class="pillars" id="explore">
            ${renderPillar({
              id: "games",
              eyebrow: "Free games",
              title: "Play in your browser",
              body: "Terminal Trainer teaches DOS-style commands on a retro workroom desk. Memory Matching flips dragon tiles on scenic maps. No download, no account — start playing on our Games hub.",
              href: "/games/",
              cta: "Play games",
              image: "/assets/kids/games/terminal/desk-monitor-frame.png",
            })}
            ${renderPillar({
              id: "kids",
              eyebrow: "Kids Show",
              title: "ABCs with Fruit Friends",
              body: "The Laughing Dragons Kids Show teaches letters through colorful fruit characters. Watch episodes on YouTube, meet the full A–Z cast, and download 3D printable files as they drop.",
              href: "/kids/",
              cta: "Go to Kids Show",
              reverse: true,
              image: "/assets/kids/best-shot.png",
            })}
            ${renderPillar({
              id: "tools",
              eyebrow: "Free Tools",
              title: "Online tools for learning",
              body: "Free browser utilities on laughing-dragons.com/tools — converters, formatters, calculators, and generators. No signup, no uploads.",
              href: "/tools/",
              cta: "Browse free tools",
            })}
            ${renderPillar({
              id: "shop",
              eyebrow: "Shop",
              title: "Apparel, prints, and maker gear",
              body: "From the workroom floor to your door — shop our Shopify store and Etsy shop for apparel, 3D prints, and maker gear. Printful-backed shipping on merch.",
              href: "/shop/",
              cta: "Visit the shop",
              reverse: true,
            })}
            ${renderPillar({
              id: "prints",
              eyebrow: "3D & Shipping",
              title: "Prints, files, and fulfillment",
              body: "Custom 3D prints from our bench, digital files where offered, and reliable shipping through our POD partners. Made in the Laughing Dragons workroom.",
              href: "/prints/",
              cta: "Browse 3D prints",
            })}
            ${renderPillar({
              id: "laser",
              eyebrow: "Laser Engraving",
              title: "Glowforge cut & engraved gifts",
              body: "Our Glowforge Pro HD is live on the floor — custom signs, coasters, nursery decor, keychains, and personalized maker pieces. Shop listings go live as we post them.",
              href: "/laser/",
              cta: "See laser engraving",
              reverse: true,
            })}
          </div>
        `,
      });
    </script>
  </body>
</html>
