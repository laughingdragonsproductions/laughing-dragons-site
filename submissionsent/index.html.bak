<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="description" content="Thank you for contacting Laughing Dragons Productions." />
    <title>Message received</title>
    <link rel="icon" href="/assets/brand/ldp-logo.png" type="image/png" />
    <link rel="stylesheet" href="/assets/css/site.css" />
    <link rel="canonical" href="https://laughing-dragons.com/submissionsent/" />
</head>
  <body>
    <div id="app"></div>
    <script src="/assets/js/config.js"></script>
    <script src="/assets/js/site.js"></script>
    <script>
      initPage({
        title: "Message received",
        description: "Thank you for contacting Laughing Dragons Productions.",
        activePath: "/submissionsent/",
        content: `
          <header class="page-header reveal">
            <p class="pillar-eyebrow">Thank you</p>
            <h1>Thank you for your message</h1>
            <p class="page-lead">We received your note and will get back to you as soon as we can.</p>
          </header>
          <div class="prose reveal">
            <p>If your question is about an order, check your Etsy or Shopify receipt for order-specific contact info — that is often the fastest path for shipping and fulfillment.</p>
            <p>
              <a class="btn btn-primary" href="/">Back to home</a>
              <a class="btn btn-ghost" href="/shop/">Visit the shop</a>
            </p>
            <p><a class="text-link" href="/contact/">Contact Us again</a></p>
          </div>
        `,
      });
    </script>
  </body>
</html>
