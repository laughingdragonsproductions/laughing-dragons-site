<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta
      name="description"
      content="Fruit Search — I-Spy hidden-object game with Fruit Friends. Find the character on busy maps."
    />
    <title>Fruit Search</title>
    <link rel="icon" href="/assets/brand/ldp-logo.png" type="image/png" />
    <link rel="stylesheet" href="/assets/css/site.css" />
    <link rel="stylesheet" href="/assets/css/fruit-search.css?v=20260810" />
    <link rel="canonical" href="https://laughing-dragons.com/games/fruit-search/" />
  </head>
  <body class="fruit-search-page game-page">
    <script src="/assets/js/config.js"></script>
    <script src="/assets/js/kids-unlocks.js"></script>
    <script>
      if (!window.KIDS_UNLOCKS?.isFruitSearchUnlocked?.()) {
        window.location.replace("/games/memory-matching/");
      }
    </script>

    <div id="game-header-mount"></div>
    <div class="container game-landing-wrap">
      <div id="game-landing-mount"></div>
    </div>

    <div id="game-play" class="container">
      <div id="fruit-search-root" class="fruit-search-root" aria-label="Fruit Search game"></div>

      <div class="fruit-search-win" id="fruit-search-win" hidden>
        <div class="fruit-search-win-card" role="dialog" aria-labelledby="fruit-search-win-title" aria-modal="true">
          <p class="fruit-search-win-stars" aria-hidden="true">★ ★ ★</p>
          <h2 id="fruit-search-win-title">You found them all!</h2>
          <p class="fruit-search-win-lede">
            Cleared the round — <strong id="fruit-search-win-finds">5</strong> finds.
          </p>
          <section class="fruit-search-win-unlock" id="fruit-search-win-unlock">
            <h3 class="fruit-search-win-unlock-title">Reward code</h3>
            <p class="fruit-search-win-unlock-text">
              Use this code in Terminal Trainer to unlock
              <strong id="fruit-search-win-unlock-game">Alphabet Trace</strong>.
            </p>
            <p class="fruit-search-win-unlock-label">Unlock code</p>
            <code class="fruit-search-win-unlock-code" id="fruit-search-win-unlock-code">TRACE-A-Z-4</code>
            <p class="fruit-search-win-unlock-hint">
              Hack it in <a href="/games/terminal/">Terminal Trainer</a>:
              <strong>LOGIN TRACE-A-Z-4</strong>
            </p>
            <a class="btn btn-primary" id="fruit-search-win-unlock-link" href="/games/#more-games">See more games</a>
          </section>
          <div class="fruit-search-win-actions">
            <button type="button" class="btn btn-primary" id="fruit-search-play-again">Play again</button>
          </div>
        </div>
      </div>

      <div class="sr-announce" id="fruit-search-sr-announce" aria-live="assertive"></div>
    </div>

    <div id="game-footer-mount"></div>

    <script src="/assets/js/games.js"></script>
    <script src="/assets/js/site.js"></script>
    <script src="/assets/js/fruit-search.js?v=20260810"></script>
    <script>
      initGameChrome({
        title: "Fruit Search",
        description: "I-Spy style hidden-object maps — find the Fruit Friend you are looking for.",
        activePath: "/games/fruit-search/",
        landingHtml: `
          <article class="game-landing prose reveal">
            <p class="game-landing-back"><a href="/games/">&larr; All games</a></p>
            <p class="pillar-eyebrow">Laughing Dragons Games</p>
            <h1>Fruit Search</h1>
            <p class="page-lead">Find Fruit Friends hidden in busy scenes — Where's Waldo meets the ABC cast.</p>
            <p>Find five Fruit Friends on any map to clear the round and earn your unlock code.</p>
          </article>`,
      });
    </script>
  </body>
</html>
