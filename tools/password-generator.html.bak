<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Generate strong random passwords locally in your browser." />
    <title>Password Generator</title>
    <link rel="stylesheet" href="/assets/css/site.css" />
    <link rel="canonical" href="https://laughing-dragons.com/tools/password-generator.html" />
    <link rel="icon" href="/assets/brand/ldp-logo.png" type="image/png" />
</head>
  <body>
    <div id="app"></div>
    <script src="/assets/js/config.js"></script>
    <script src="/assets/js/tools.js"></script>
    <script src="/assets/js/site.js"></script>
    <script>
      initToolPage({
        title: "Password Generator",
        description: "Generate strong random passwords locally in your browser.",
        content: `
          <section class="tool-panel">
            <h1>Password Generator</h1>
            <p class="lede">Generated locally with crypto.getRandomValues — nothing is sent to a server.</p>
            <div class="field-grid two">
              <div>
                <label for="length">Length</label>
                <input id="length" type="number" value="16" min="8" max="128" />
              </div>
            </div>
            <fieldset style="border:none;padding:0;margin:1rem 0">
              <legend style="font-weight:600;margin-bottom:0.5rem">Include</legend>
              <label><input type="checkbox" id="lower" checked /> Lowercase</label><br />
              <label><input type="checkbox" id="upper" checked /> Uppercase</label><br />
              <label><input type="checkbox" id="digits" checked /> Numbers</label><br />
              <label><input type="checkbox" id="symbols" checked /> Symbols</label>
            </fieldset>
            <button type="button" id="generate">Generate</button>
            <button type="button" id="copy" class="secondary" style="margin-left:0.5rem">Copy</button>
            <div id="result" class="result" aria-live="polite"></div>
          </section>
        `,
      });

      const sets = {
        lower: "abcdefghijklmnopqrstuvwxyz",
        upper: "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
        digits: "0123456789",
        symbols: "!@#$%^&*()-_=+[]{}",
      };

      function generate() {
        let pool = "";
        if (document.getElementById("lower").checked) pool += sets.lower;
        if (document.getElementById("upper").checked) pool += sets.upper;
        if (document.getElementById("digits").checked) pool += sets.digits;
        if (document.getElementById("symbols").checked) pool += sets.symbols;
        const len = Number(document.getElementById("length").value);
        const resultEl = document.getElementById("result");
        if (!pool || Number.isNaN(len) || len < 8) {
          resultEl.textContent = "Choose at least one character set and length ≥ 8.";
          resultEl.classList.add("error");
          return;
        }
        const bytes = new Uint32Array(len);
        crypto.getRandomValues(bytes);
        let out = "";
        for (let i = 0; i < len; i++) out += pool[bytes[i] % pool.length];
        resultEl.classList.remove("error");
        resultEl.textContent = out;
      }

      document.getElementById("generate").addEventListener("click", generate);
      document.getElementById("copy").addEventListener("click", async () => {
        const text = document.getElementById("result").textContent;
        if (!text || text.includes("Choose at least")) return;
        await navigator.clipboard.writeText(text);
      });
      generate();
    </script>
  </body>
</html>
