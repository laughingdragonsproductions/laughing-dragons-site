<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Free online learning tools at laughing-dragons.com — converters, calculators, formatters, and generators in your browser." />
    <title>Free Tools</title>
    <link rel="icon" href="/assets/brand/ldp-logo.png" type="image/png" />
    <link rel="stylesheet" href="/assets/css/site.css" />
    <link rel="canonical" href="https://laughing-dragons.com/tools/" />
</head>
  <body>
    <div id="app"></div>
    <script src="/assets/js/config.js"></script>
    <script src="/assets/js/tools.js"></script>
    <script src="/assets/js/site.js"></script>
    <script>
      initPage({
        title: "Free Tools",
        description: "Free online learning tools at laughing-dragons.com — converters, calculators, formatters, and generators in your browser.",
        activePath: "/tools/",
        content: `
          <header class="page-header reveal">
            <p class="pillar-eyebrow">Free &amp; browser-based</p>
            <h1>Learning tools</h1>
            <p>Everyday utilities that run entirely in your browser on laughing-dragons.com. No signup, no uploads — free for learning and practical use.</p>
          </header>
          ${renderToolGrid()}
          ${renderToolsComingSoon()}
          <div class="prose reveal">
            <p>All tools stay on this site under <strong>/tools/</strong>. Nothing is uploaded to our servers — everything runs locally in your browser.</p>
          </div>
        `,
      });
    </script>
  </body>
</html>
