<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Contact Laughing Dragons Productions — questions about orders, the kids show, apps, or collaborations." />
    <title>Contact Us</title>
    <link rel="icon" href="/assets/brand/ldp-logo.png" type="image/png" />
    <link rel="stylesheet" href="/assets/css/site.css" />
    <link rel="canonical" href="https://laughing-dragons.com/contact/" />
</head>
  <body>
    <div id="app"></div>
    <script src="/assets/js/config.js"></script>
    <script src="/assets/js/site.js"></script>
    <script>
      initPage({
        title: "Contact Us",
        description: "Contact Laughing Dragons Productions — questions about orders, the kids show, apps, or collaborations.",
        activePath: "/contact/",
        content: `
          <header class="page-header reveal">
            <p class="pillar-eyebrow">Get in touch</p>
            <h1>Contact Us</h1>
            <p class="page-lead">Questions about orders, the kids show, apps, or collaborations — use the form below.</p>
          </header>
          ${renderContactForm({
            intro: "For order-specific help, use the contact email on your Etsy or Shopify receipt.",
          })}
        `,
      });
      bindContactForm({ subjectPrefix: "Laughing Dragons Productions" });
    </script>
  </body>
</html>
