/* Kids Terminal Trainer V2 — desk monitor shell + terminal */
:root {
  --term-bg: #0a0a0a;
  --term-green: #39ff14;
  --term-green-dim: #1a8010;
  --term-green-glow: rgba(57, 255, 20, 0.35);
  --term-font: "Consolas", "Lucida Console", "Courier New", monospace;
  --monitor-top: 7%;
  --monitor-left: 18%;
  --monitor-width: 64.6%;
  --monitor-height: 63.4%;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

.terminal-page {
  min-height: 100vh;
  background: var(--term-bg);
  color: var(--term-green);
  font-family: var(--term-font);
  overflow: hidden;
}

.terminal-back-link,
.replay-intro-link,
.hints-panel-toggle {
  position: fixed;
  z-index: 40;
  color: var(--term-green);
  font: inherit;
  font-size: 0.85rem;
  background: rgba(10, 10, 10, 0.75);
  border: 1px solid var(--term-green-dim);
  padding: 0.35rem 0.65rem;
}

.terminal-back-link {
  top: 0.75rem;
  left: 0.75rem;
  text-decoration: none;
}

.hints-panel-toggle {
  top: 0.75rem;
  right: 0.75rem;
  cursor: pointer;
  letter-spacing: 0.06em;
}

.hints-panel-toggle[aria-expanded="true"] {
  background: rgba(57, 255, 20, 0.18);
  border-color: var(--term-green);
  text-shadow: 0 0 8px var(--term-green-glow);
}

.replay-intro-link {
  top: 2.85rem;
  right: 0.75rem;
  cursor: pointer;
}

.terminal-back-link:hover,
.replay-intro-link:hover,
.hints-panel-toggle:hover {
  text-shadow: 0 0 8px var(--term-green-glow);
}

.hints-panel-toggle[hidden],
.replay-intro-link[hidden] {
  display: none;
}

/* Intro video — stacked on desk frame inside shared 16:9 canvas */
.intro-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 2;
  display: block;
  pointer-events: none;
  transition: opacity 280ms ease;
}

.intro-video.is-hidden {
  opacity: 0;
  visibility: hidden;
}

.intro-skip-btn,
.intro-fallback-btn {
  position: fixed;
  z-index: 40;
  color: var(--term-green);
  font: inherit;
  font-size: 0.82rem;
  background: rgba(10, 10, 10, 0.72);
  border: 1px solid var(--term-green-dim);
  padding: 0.35rem 0.65rem;
  cursor: pointer;
}

.intro-skip-btn {
  right: 0.75rem;
  bottom: 0.75rem;
  opacity: 0.75;
}

.intro-fallback-btn {
  left: 50%;
  bottom: 2rem;
  transform: translateX(-50%);
}

.intro-skip-btn:hover,
.intro-fallback-btn:hover {
  opacity: 1;
  text-shadow: 0 0 8px var(--term-green-glow);
}

.intro-skip-btn[hidden],
.intro-fallback-btn[hidden] {
  display: none;
}

.monitor-viewport--hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.monitor-viewport.is-revealed {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transition: opacity 280ms ease;
}

/* Hints sidebar — hidden until HELP toggle opens it */
.terminal-hints {
  width: min(240px, 28vw);
  flex-shrink: 0;
  padding: 1rem 0.85rem;
  border-left: 1px solid var(--term-green-dim);
  background: rgba(57, 255, 20, 0.03);
  font-size: 0.82rem;
  line-height: 1.45;
}

.terminal-hints[hidden] {
  display: none;
}

.game-layout {
  display: flex;
  min-height: 100vh;
  width: 100%;
}

.game-layout[hidden] {
  display: none;
}

.game-layout.is-intro .replay-intro-link,
.game-layout.is-intro .hints-panel-toggle {
  display: none;
}

.desk-stage {
  flex: 1;
  position: relative;
  min-height: 100vh;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.5rem;
}

/* Locked to desk image 1024×576 — overlay % tracks the photo exactly */
.desk-canvas {
  position: relative;
  width: min(100%, calc((100vh - 1rem) * 16 / 9));
  max-height: calc(100vh - 1rem);
  aspect-ratio: 16 / 9;
  overflow: hidden;
}

.desk-frame {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  pointer-events: none;
  user-select: none;
}

.monitor-viewport {
  position: absolute;
  top: var(--monitor-top);
  left: var(--monitor-left);
  width: var(--monitor-width);
  height: var(--monitor-height);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--term-bg);
  border: none;
  box-shadow: none;
  container-type: size;
  font-size: clamp(0.65rem, 1.65cqw, 1.15rem);
}

.monitor-hud {
  flex-shrink: 0;
  padding: 0.35em 0.55em;
  border-bottom: 1px solid var(--term-green-dim);
  font-size: 0.85em;
  text-align: right;
  opacity: 0.9;
}

.terminal-shell {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0.45em 0.55em 0.5em;
  gap: 0.4em;
  min-height: 0;
}

.terminal-screen {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 0.45em 0.55em;
  border: 1px solid var(--term-green-dim);
  background:
    repeating-linear-gradient(
      0deg,
      rgba(57, 255, 20, 0.03) 0,
      rgba(57, 255, 20, 0.03) 1px,
      transparent 1px,
      transparent 3px
    ),
    var(--term-bg);
  line-height: 1.35;
  font-size: 1em;
  white-space: pre-wrap;
  word-break: break-word;
}

.terminal-line {
  margin: 0;
}

.terminal-line.input-echo,
.terminal-line.output {
  color: var(--term-green);
}

.terminal-line.error {
  color: #ff6b6b;
}

.terminal-line.success {
  text-shadow: 0 0 6px var(--term-green-glow);
}

.terminal-line.dim {
  opacity: 0.75;
}

.terminal-input-row {
  display: flex;
  align-items: center;
  border: 1px solid var(--term-green-dim);
  padding: 0.35em 0.5em;
  background: rgba(57, 255, 20, 0.04);
  flex-shrink: 0;
}

.terminal-prompt-label {
  flex-shrink: 0;
  user-select: none;
  font-size: 1em;
}

.terminal-input {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  color: var(--term-green);
  font: inherit;
  font-size: 1em;
  caret-color: var(--term-green);
  min-width: 0;
}

.terminal-panel {
  border: 1px solid var(--term-green-dim);
  padding: 0.35em 0.5em;
  background: rgba(57, 255, 20, 0.03);
  flex-shrink: 0;
}

.terminal-panel-title {
  margin: 0 0 0.35em;
  font-size: 0.75em;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.command-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.2rem;
}

.command-btn {
  border: 1px solid var(--term-green-dim);
  background: rgba(57, 255, 20, 0.08);
  color: var(--term-green);
  font: inherit;
  font-size: 0.72em;
  padding: 0.25em 0.45em;
  cursor: pointer;
}

.command-btn:hover,
.command-btn:focus-visible {
  background: rgba(57, 255, 20, 0.18);
  outline: none;
}

.terminal-restart {
  flex-shrink: 0;
}

.terminal-restart button {
  border: 1px solid var(--term-green);
  background: transparent;
  color: var(--term-green);
  font: inherit;
  font-size: 0.55rem;
  padding: 0.25rem 0.5rem;
  cursor: pointer;
}

.terminal-restart[hidden] {
  display: none;
}

/* Hints sidebar content */
.terminal-hints-title {
  margin: 0 0 0.65rem;
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.terminal-hint {
  margin: 0 0 0.85rem;
}

.terminal-hint-tip {
  opacity: 0.85;
  font-size: 0.78rem;
}

.terminal-hint kbd {
  border: 1px solid var(--term-green-dim);
  padding: 0.05rem 0.3rem;
  font-size: 0.75rem;
}

/* Mobile: terminal-only fallback */
@media (max-width: 768px) {
  .game-layout {
    flex-direction: column;
  }

  .desk-stage {
    min-height: auto;
    background: var(--term-bg);
  }

  .desk-frame {
    display: none;
  }

  .monitor-viewport {
    position: static;
    width: 100%;
    height: auto;
    min-height: calc(100vh - 120px);
    border: none;
    box-shadow: none;
  }

  .monitor-hud {
    font-size: 0.75rem;
    text-align: left;
  }

  .terminal-screen {
    min-height: 45vh;
    font-size: 0.85rem;
  }

  .terminal-prompt-label,
  .terminal-input {
    font-size: 0.85rem;
  }

  .command-btn {
    font-size: 0.75rem;
    padding: 0.3rem 0.5rem;
  }

  .terminal-hints {
    width: 100%;
    border-left: none;
    border-top: 1px solid var(--term-green-dim);
  }

  .terminal-shell {
    padding: 0.75rem;
    gap: 0.5rem;
  }
}

/* Win banner overlay */
.terminal-win-banner {
  position: absolute;
  inset: 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  background: rgba(5, 5, 5, 0.97);
  border: 2px solid var(--term-green);
  box-shadow: inset 0 0 40px rgba(57, 255, 20, 0.12);
  animation: terminal-win-in 0.45s ease-out;
}

.terminal-win-banner[hidden] {
  display: none;
}

@keyframes terminal-win-in {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.terminal-win-banner-inner {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.55em;
  padding: 0.65em 0.7em 0.75em;
  min-height: min-content;
}

.terminal-win-stars {
  margin: 0;
  text-align: center;
  font-size: 1.05em;
  letter-spacing: 0.12em;
  text-shadow: 0 0 14px var(--term-green-glow);
  animation: terminal-win-pulse 1.6s ease-in-out infinite;
}

@keyframes terminal-win-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.72;
  }
}

.terminal-win-title {
  margin: 0;
  text-align: center;
  font-size: 0.95em;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.terminal-win-lede {
  margin: 0 0 0.15em;
  text-align: center;
  font-size: 0.78em;
  opacity: 0.9;
}

.terminal-win-reward {
  border: 1px solid var(--term-green-dim);
  padding: 0.45em 0.5em;
  background: rgba(57, 255, 20, 0.04);
}

.terminal-win-reward-title {
  margin: 0 0 0.3em;
  font-size: 0.72em;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.85;
}

.terminal-win-reward-text {
  margin: 0 0 0.35em;
  font-size: 0.78em;
  line-height: 1.35;
}

.terminal-win-reward-label {
  margin: 0 0 0.2em;
  font-size: 0.65em;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  opacity: 0.75;
}

.terminal-win-code-row {
  display: flex;
  align-items: stretch;
  gap: 0.35em;
}

.terminal-win-code {
  flex: 1;
  display: block;
  padding: 0.35em 0.45em;
  border: 1px solid var(--term-green-dim);
  background: rgba(0, 0, 0, 0.55);
  font: inherit;
  font-size: 0.82em;
  letter-spacing: 0.05em;
  color: var(--term-green);
  word-break: break-all;
}

.terminal-win-copy {
  flex-shrink: 0;
  border: 1px solid var(--term-green-dim);
  background: rgba(57, 255, 20, 0.1);
  color: var(--term-green);
  font: inherit;
  font-size: 0.68em;
  padding: 0.35em 0.5em;
  cursor: pointer;
}

.terminal-win-copy:hover {
  background: rgba(57, 255, 20, 0.2);
}

.terminal-win-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35em;
  margin-top: auto;
  padding-top: 0.25em;
}

.terminal-win-btn {
  flex: 1 1 auto;
  min-width: 5.5em;
  border: 1px solid var(--term-green);
  background: rgba(57, 255, 20, 0.14);
  color: var(--term-green);
  font: inherit;
  font-size: 0.68em;
  padding: 0.4em 0.55em;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
}

.terminal-win-btn-ghost {
  background: transparent;
  border-color: var(--term-green-dim);
}

.terminal-win-btn:hover {
  background: rgba(57, 255, 20, 0.24);
}

@media (max-width: 768px) {
  .terminal-win-banner {
    position: fixed;
    inset: 0;
    z-index: 50;
    border: none;
  }

  .terminal-win-banner-inner {
    padding: 1rem;
    gap: 0.75rem;
  }

  .terminal-win-stars {
    font-size: 1.15rem;
  }

  .terminal-win-title {
    font-size: 1rem;
  }

  .terminal-win-reward-text,
  .terminal-win-code {
    font-size: 0.9rem;
  }
}

@media (min-width: 769px) and (max-width: 1100px) {
  :root {
    --monitor-top: 7%;
    --monitor-left: 18%;
    --monitor-width: 64.6%;
    --monitor-height: 63.4%;
  }

  .terminal-hints {
    width: 200px;
    font-size: 0.75rem;
  }
}
